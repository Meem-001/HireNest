@model IEnumerable<InternshipManagementSystem.Models.Internship>
@{
    ViewData["Title"] = "My Internships";
    int postsRemaining = ViewBag.PostsRemaining ?? 0;
    string packageType = ViewBag.PackageType ?? "Free";
    bool showPopup = TempData["PostsRemaining"] != null;
    int popupPostsRemaining = showPopup ? (int)TempData["PostsRemaining"] : 0;
}

<style>
    .myint-page {
        background: #0B1220;
        min-height: 100vh;
        padding: 3rem 0 4rem;
        color: #E2E8F0;
    }

    .dash-card {
        background: linear-gradient(135deg, rgba(37,99,235,.25) 0%, rgba(15,23,42,.8) 100%);
        border: 1px solid rgba(59,130,246,.35);
        border-radius: 16px;
        padding: 1.8rem;
    }

    .package-badge {
        background: rgba(148,163,184,.12);
        border: 1px solid rgba(148,163,184,.3);
        color: #CBD5E1;
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 700;
        padding: .3rem .9rem;
    }

    .posts-num {
        font-size: 3rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

    .warn-box {
        background: rgba(245,158,11,.1);
        border: 1px solid rgba(245,158,11,.4);
        border-radius: 10px;
        padding: .8rem 1.2rem;
        color: #FBBF24;
        margin-top: 1.2rem;
    }

    .danger-box {
        background: rgba(248,113,113,.1);
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 10px;
        padding: .8rem 1.2rem;
        color: #F87171;
        margin-top: 1.2rem;
    }

    .btn-blue {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        padding: .7rem 1.4rem;
        text-decoration: none;
        transition: all .2s;
        display: inline-block;
    }

        .btn-blue:hover {
            background: #1D4ED8;
            color: #fff;
            transform: translateY(-2px);
        }

    .btn-amber {
        background: #F59E0B;
        color: #0B1220;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        padding: .7rem 1.4rem;
        text-decoration: none;
        transition: all .2s;
        display: inline-block;
    }

        .btn-amber:hover {
            background: #D97706;
            color: #0B1220;
        }

    .adm-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-table {
        margin: 0;
        width: 100%;
    }

        .adm-table thead th {
            background: rgba(148,163,184,.06);
            color: #94A3B8;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: .9rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .adm-table tbody td {
            padding: 1rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.08);
            color: #CBD5E1;
            font-size: .9rem;
            vertical-align: middle;
        }

        .adm-table tbody tr:hover {
            background: rgba(148,163,184,.04);
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .btn-edit {
        background: rgba(59,130,246,.1);
        color: #60A5FA;
        border: 1px solid rgba(59,130,246,.35);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .35rem .8rem;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: rgba(59,130,246,.2);
            color: #93C5FD;
        }

    .btn-del {
        background: rgba(248,113,113,.1);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .35rem .8rem;
    }

        .btn-del:hover {
            background: rgba(248,113,113,.2);
            color: #FCA5A5;
        }

    .alert-ok {
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.35);
        color: #34D399;
        border-radius: 10px;
    }

    .alert-err {
        background: rgba(248,113,113,.1);
        border: 1px solid rgba(248,113,113,.35);
        color: #F87171;
        border-radius: 10px;
    }

    .empty-box {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        text-align: center;
        padding: 4rem 2rem;
    }

    .modal-content.dark-modal {
        background: #0F1A2E;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 20px;
        color: #E2E8F0;
    }

    .modal-stat {
        font-size: 3rem;
        font-weight: 800;
        color: #60A5FA;
    }

    .btn-ghost {
        background: rgba(148,163,184,.08);
        color: #CBD5E1;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .7rem 1.4rem;
    }

        .btn-ghost:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }
</style>

<section class="myint-page">
    <div class="container">

        <!-- ===== POSTING DASHBOARD ===== -->
        <div class="dash-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="fw-bold text-uppercase mb-2" style="color: #60A5FA; letter-spacing: 2px; font-size: .72rem;">Company Dashboard</div>
                    <h3 class="fw-bold mb-2" style="color: #fff;">📊 Your Posting Dashboard</h3>
                    <p class="mb-0" style="color: #94A3B8;">
                        Current Package: <span class="package-badge">@packageType</span>
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="posts-num">@postsRemaining</div>
                    <div style="color: #94A3B8;">Posts Remaining</div>
                </div>
            </div>

            @if (postsRemaining <= 1 && postsRemaining > 0)
            {
                <div class="warn-box d-flex justify-content-between align-items-center flex-wrap">
                    <span>⚠️ <strong>Warning:</strong> You have only @postsRemaining post remaining.</span>
                    <a asp-controller="Payment" asp-action="Checkout" class="btn-amber btn-sm mt-2 mt-sm-0">⚡ Upgrade to Premium</a>
                </div>
            }
            else if (postsRemaining == 0)
            {
                <div class="danger-box d-flex justify-content-between align-items-center flex-wrap">
                    <span>🚫 <strong>No posts remaining!</strong> Upgrade to Premium to post more internships.</span>
                    <a asp-controller="Payment" asp-action="Checkout" class="btn-amber btn-sm mt-2 mt-sm-0">⚡ Upgrade Now</a>
                </div>
            }
        </div>

        <!-- ===== HEADER ===== -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <h2 class="fw-bold mb-0" style="color: #fff;">📋 My Posted Internships</h2>
            @if (postsRemaining > 0)
            {
                <a asp-action="Create" class="btn-blue">+ Post New Internship</a>
            }
            else
            {
                <a asp-controller="Payment" asp-action="Checkout" class="btn-amber">⚡ Upgrade to Post More</a>
            }
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert-ok p-3 mb-3">✅ @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-err p-3 mb-3">❌ @TempData["Error"]</div>
        }

        @if (Model.Any())
        {
            <div class="adm-card table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Location</th>
                            <th>Duration</th>
                            <th>Posted On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="color: #fff; font-weight: 600;">@item.Title</td>
                                <td><i class="bi bi-geo-alt me-1" style="color: #64748B;"></i>@item.Location</td>
                                <td>@item.Duration</td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-edit"><i class="bi bi-pencil me-1"></i>Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this internship?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-del"><i class="bi bi-trash3 me-1"></i>Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <div class="display-1 mb-3">📭</div>
                <h4 class="fw-bold" style="color: #fff;">You haven't posted any internships yet.</h4>
                <p class="mb-4" style="color: #94A3B8;">Start attracting talented students by posting your first internship!</p>
                @if (postsRemaining > 0)
                {
                    <a asp-action="Create" class="btn-blue">+ Post Your First Internship</a>
                }
                else
                {
                    <a asp-controller="Payment" asp-action="Checkout" class="btn-amber">⚡ Upgrade to Start Posting</a>
                }
            </div>
        }
    </div>
</section>

<!-- ✅ POPUP MODAL (Dark Restyled) -->
@if (showPopup)
{
    <div class="modal fade" id="postSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content dark-modal">
                <div class="modal-body text-center p-5">
                    <div class="display-1 mb-3">@(popupPostsRemaining > 0 ? "🎉" : "⚠️")</div>
                    <h3 class="fw-bold mb-4" style="color: #fff;">
                        @(popupPostsRemaining > 0 ? "Internship Posted Successfully!" : "Last Post Used!")
                    </h3>

                    @if (popupPostsRemaining > 0)
                    {
                        <div class="mb-3">
                            <span class="modal-stat">@popupPostsRemaining</span>
                            <div style="color: #94A3B8;">post@(popupPostsRemaining > 1 ? "s" : "") remaining</div>
                        </div>
                        <p style="color: #94A3B8;">
                            @if (popupPostsRemaining == 1)
                            {
                                <text><strong style="color: #FBBF24;">⚠️ Heads up!</strong> This is your last free post. Consider upgrading to Premium.</text>
                            }
                            else
                            {
                                <text>Keep posting to attract the best students!</text>
                            }
                        </p>
                    }
                    else
                    {
                        <div class="danger-box mb-3" style="margin-top: 0 !important;">
                            <h5 class="fw-bold">You've used all your free posts!</h5>
                            <p class="mb-0">Upgrade to Premium to unlock more internship postings.</p>
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4" style="max-width: 320px; margin: 0 auto;">
                        @if (popupPostsRemaining > 0)
                        {
                            <a asp-action="Create" class="btn-blue text-center">+ Post Another Internship</a>
                            <button type="button" class="btn-ghost" data-bs-dismiss="modal">View My Internships</button>
                        }
                        else
                        {
                            <a asp-controller="Payment" asp-action="Checkout" class="btn-amber text-center">⚡ Upgrade to Premium</a>
                            <button type="button" class="btn-ghost" data-bs-dismiss="modal">Close</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = new bootstrap.Modal(document.getElementById('postSuccessModal'));
            modal.show();
        });
    </script>
}