<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HireNest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InternshipManagementSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        .navbar-dark .nav-link {
            color: #CBD5E1;
            font-weight: 500;
        }

            .navbar-dark .nav-link:hover {
                color: #ffffff;
            }

        .admin-btn {
            background: rgba(245,158,11,.12);
            color: #FBBF24;
            border: 1px solid rgba(245,158,11,.5);
            border-radius: 8px;
            font-weight: 600;
            padding: .35rem .9rem;
            text-decoration: none;
        }

            .admin-btn:hover {
                background: rgba(245,158,11,.22);
                color: #FDE68A;
            }

        .btn-get-started {
            background: #2563EB;
            color: #fff;
            border-radius: 8px;
            font-weight: 600;
            padding: .4rem 1rem;
            text-decoration: none;
        }

            .btn-get-started:hover {
                background: #1D4ED8;
                color: #fff;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark" style="background: #0B1220; border-bottom: 1px solid rgba(148,163,184,0.15);">
            <div class="container-fluid px-4">

                @{
                    string logoController = "Home";
                    string logoAction = "Index";
                    if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Student")) { logoController = "Internship"; logoAction = "Index"; }
                        else if (User.IsInRole("Company")) { logoController = "Internship"; logoAction = "MyInternships"; }
                        else if (User.IsInRole("Admin")) { logoController = "Admin"; logoAction = "Index"; }
                    }
                }
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="@logoController" asp-action="@logoAction" style="font-size: 1.3rem; letter-spacing: -0.5px;">
                    <span style="color: #ffffff;">Hire</span><span style="color: #3B82F6;">Nest</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Internship" asp-action="Index">Browse Jobs</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="SkillMatch">Skill Match</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Application" asp-action="MyApplications">My Applications</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="CV" asp-action="View">My CV</a></li>
                            }

                            @if (User.IsInRole("Company"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="EditProfile">Edit Profile</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Internship" asp-action="MyInternships">My Internships</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Application" asp-action="CompanyApplications">View Applicants</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Payment" asp-action="History">Payment History</a></li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin Panel</a></li>
                                <li class="nav-item"><a class="nav-link fw-bold" style="color: #FBBF24;" asp-controller="Admin" asp-action="PendingUpgrades">⏳ Pending Upgrades</a></li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><span class="nav-link" style="color: #CBD5E1;">Hello, @User.Identity.Name!</span></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a></li>
                            <li class="nav-item mx-2"><a class="admin-btn" asp-controller="Account" asp-action="AdminLogin"><i class="bi bi-lock-fill me-1"></i> Admin</a></li>
                            <li class="nav-item"><a class="btn-get-started" asp-controller="Account" asp-action="Register">Get Started</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ✅ No container wrapper = full-width pages -->
    <main role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- ✅ HIRENEST AI CHATBOT WIDGET ✅ -->
    <style>
        /* Floating Button */
        .chat-toggle-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #FBBF24, #F59E0B);
            border: none;
            color: #0B1220;
            font-size: 28px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(251, 191, 36, 0.4);
            z-index: 1000;
            transition: transform 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .chat-toggle-btn:hover {
                transform: scale(1.1);
            }

        /* Chat Window */
        .chat-window {
            position: fixed;
            bottom: 100px;
            right: 30px;
            width: 350px;
            height: 450px;
            background: #1E293B;
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            z-index: 999;
            display: none; /* Hidden by default */
            flex-direction: column;
            overflow: hidden;
        }

            .chat-window.active {
                display: flex;
            }

        /* Chat Header */
        .chat-header {
            background: #0F172A;
            padding: 15px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .chat-header h5 {
                margin: 0;
                color: #FBBF24;
                font-size: 1rem;
                font-weight: 600;
            }

        .chat-close {
            background: none;
            border: none;
            color: #94A3B8;
            font-size: 1.2rem;
            cursor: pointer;
        }

        /* Chat Body */
        .chat-body {
            flex: 1;
            padding: 15px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .chat-message {
            max-width: 80%;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .msg-ai {
            background: rgba(148, 163, 184, 0.1);
            color: #E2E8F0;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
        }

        .msg-user {
            background: #FBBF24;
            color: #0B1220;
            align-self: flex-end;
            border-bottom-right-radius: 2px;
            font-weight: 500;
        }

        /* Chat Input */
        .chat-input-area {
            padding: 15px;
            background: #0F172A;
            border-top: 1px solid rgba(148, 163, 184, 0.1);
            display: flex;
            gap: 10px;
        }

            .chat-input-area input {
                flex: 1;
                background: rgba(148, 163, 184, 0.05);
                border: 1px solid rgba(148, 163, 184, 0.2);
                color: #fff;
                padding: 10px;
                border-radius: 8px;
                outline: none;
            }

            .chat-input-area button {
                background: #FBBF24;
                color: #0B1220;
                border: none;
                padding: 0 15px;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
            }
    </style>

    <!-- Chat Button -->
    <button class="chat-toggle-btn" onclick="toggleChat()">🤖</button>

    <!-- Chat Window -->
    <div class="chat-window" id="chatWindow">
        <div class="chat-header">
            <h5>✨ HireNest AI Assistant</h5>
            <button class="chat-close" onclick="toggleChat()">✕</button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-message msg-ai">Hello! I'm the HireNest AI. How can I help you with internships today?</div>
        </div>
        <div class="chat-input-area">
            <input type="text" id="chatInput" placeholder="Ask me anything..." onkeypress="handleKeyPress(event)">
            <button onclick="sendMessage()">Send</button>
        </div>
    </div>

    <script>
        function toggleChat() {
            document.getElementById('chatWindow').classList.toggle('active');
        }

        function handleKeyPress(event) {
            if (event.key === 'Enter') sendMessage();
        }

        async function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            const chatBody = document.getElementById('chatBody');

            // Add User Message
            chatBody.innerHTML += `<div class="chat-message msg-user">${message}</div>`;
            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Add Loading State
            const loadingId = 'loading-' + Date.now();
            chatBody.innerHTML += `<div class="chat-message msg-ai" id="${loadingId}">Thinking...</div>`;
            chatBody.scrollTop = chatBody.scrollHeight;

            try {
                // Call our C# Controller
                const response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(message)
                });

                const data = await response.json();

                // Remove loading and show AI response
                document.getElementById(loadingId).remove();
                chatBody.innerHTML += `<div class="chat-message msg-ai">${data.reply}</div>`;
            } catch (error) {
                document.getElementById(loadingId).innerText = "Sorry, I'm having trouble connecting right now.";
            }
            chatBody.scrollTop = chatBody.scrollHeight;
        }
    </script>
    <!-- ✅ END CHATBOT WIDGET ✅ -->
</body>
</html>