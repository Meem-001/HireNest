@model IEnumerable<InternshipManagementSystem.Models.Application>
@{
    ViewData["Title"] = "Manage Applications";
}

<style>
    .adm-page {
        background: #0B1220;
        min-height: 100vh;
        padding: 3rem 0 4rem;
        color: #E2E8F0;
    }

    .adm-label {
        color: #FBBF24;
        letter-spacing: 2px;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .adm-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-table {
        margin: 0;
        width: 100%;
    }

        .adm-table thead th {
            background: rgba(148,163,184,.06);
            color: #94A3B8;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: .9rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .adm-table tbody td {
            padding: 1rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.08);
            color: #CBD5E1;
            font-size: .9rem;
            vertical-align: middle;
        }

        .adm-table tbody tr:hover {
            background: rgba(148,163,184,.04);
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tag {
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 600;
        padding: .3rem .7rem;
    }

    .tag-green {
        background: rgba(52,211,153,.12);
        color: #34D399;
        border: 1px solid rgba(52,211,153,.35);
    }

    .tag-red {
        background: rgba(248,113,113,.12);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.35);
    }

    .tag-amber {
        background: rgba(245,158,11,.12);
        color: #FBBF24;
        border: 1px solid rgba(245,158,11,.4);
    }

    .tag-blue {
        background: rgba(59,130,246,.12);
        color: #60A5FA;
        border: 1px solid rgba(59,130,246,.35);
    }

    .adm-select {
        background: rgba(148,163,184,.08);
        border: 1px solid rgba(148,163,184,.25);
        color: #E2E8F0;
        border-radius: 8px;
        font-size: .8rem;
        padding: .35rem .6rem;
    }

        .adm-select:focus {
            outline: none;
            border-color: #3B82F6;
        }

        .adm-select option {
            background: #0B1220;
        }

    .btn-del {
        background: rgba(248,113,113,.1);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .35rem .6rem;
    }

        .btn-del:hover {
            background: rgba(248,113,113,.2);
            color: #FCA5A5;
        }

    .btn-back {
        background: rgba(148,163,184,.08);
        color: #CBD5E1;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1.2rem;
        text-decoration: none;
        display: inline-block;
    }

        .btn-back:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }

    .alert-ok {
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.35);
        color: #34D399;
        border-radius: 10px;
    }
</style>

<section class="adm-page">
    <div class="container">
        <div class="adm-label mb-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin / Applications</div>
        <h1 class="fw-bold mb-1" style="color: #fff; font-size: 2rem;">📋 Manage Applications</h1>
        <p class="mb-4" style="color: #94A3B8;">Review and manage all student applications.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-ok p-3 mb-3">@TempData["Success"]</div>
        }

        <div class="adm-card table-responsive">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Email</th>
                        <th>Company</th>
                        <th>Internship</th>
                        <th>Status</th>
                        <th>Applied On</th>
                        <th>Admin Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td style="color: #fff; font-weight: 600;">@app.StudentName</td>
                            <td>@app.StudentEmail</td>
                            <td><span class="tag tag-blue">@app.CompanyName</span></td>
                            <td>@app.InternshipTitle</td>
                            <td>
                                <span class="tag @(app.Status == "Accepted" ? "tag-green" : app.Status == "Rejected" ? "tag-red" : "tag-amber")">@app.Status</span>
                            </td>
                            <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <form asp-action="UpdateApplicationStatus" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <select name="status" class="adm-select" onchange="this.form.submit()">
                                            <option value="Pending" selected="@(app.Status == "Pending")">Pending</option>
                                            <option value="Accepted" selected="@(app.Status == "Accepted")">Accept</option>
                                            <option value="Rejected" selected="@(app.Status == "Rejected")">Reject</option>
                                        </select>
                                    </form>
                                    <form asp-action="DeleteApplication" method="post" style="display:inline;" onsubmit="return confirm('Delete this application?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@app.Id" />
                                        <button type="submit" class="btn-del"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-action="Index" class="btn-back mt-4">← Back to Dashboard</a>
    </div>
</section>