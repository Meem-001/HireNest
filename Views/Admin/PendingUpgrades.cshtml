@model IEnumerable<InternshipManagementSystem.Models.PaymentTransaction>
@{
    ViewData["Title"] = "Pending Upgrades";
}

<style>
    .adm-page {
        background: radial-gradient(800px 400px at 80% 0%, rgba(245,158,11,0.05), transparent 60%), #0B1220;
        min-height: 100vh;
        padding: 3rem 0 4rem;
        color: #E2E8F0;
    }

    .adm-label {
        color: #FBBF24;
        letter-spacing: 2px;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .adm-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-table {
        margin: 0;
        width: 100%;
    }

        .adm-table thead th {
            background: rgba(148,163,184,.06);
            color: #94A3B8;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: .9rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .adm-table tbody td {
            padding: 1rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.08);
            color: #CBD5E1;
            font-size: .9rem;
            vertical-align: middle;
        }

        .adm-table tbody tr:hover {
            background: rgba(245,158,11,.04);
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tag {
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 600;
        padding: .3rem .7rem;
    }

    .tag-blue {
        background: rgba(59,130,246,.12);
        color: #60A5FA;
        border: 1px solid rgba(59,130,246,.35);
    }

    .txn-id {
        font-family: monospace;
        color: #60A5FA;
        font-weight: 700;
    }

    .amount {
        color: #34D399;
        font-weight: 700;
    }

    .btn-ok {
        background: rgba(52,211,153,.12);
        color: #34D399;
        border: 1px solid rgba(52,211,153,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .4rem .9rem;
    }

        .btn-ok:hover {
            background: rgba(52,211,153,.22);
            color: #6EE7B7;
        }

    .btn-del {
        background: rgba(248,113,113,.1);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .4rem .9rem;
    }

        .btn-del:hover {
            background: rgba(248,113,113,.2);
            color: #FCA5A5;
        }

    .btn-back {
        background: rgba(148,163,184,.08);
        color: #CBD5E1;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1.2rem;
        text-decoration: none;
        display: inline-block;
    }

        .btn-back:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }

    .alert-ok {
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.35);
        color: #34D399;
        border-radius: 10px;
    }

    .empty-box {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        text-align: center;
        padding: 4rem 2rem;
    }
</style>

<section class="adm-page">
    <div class="container">
        <div class="adm-label mb-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin / Approvals</div>
        <h1 class="fw-bold mb-1" style="color: #fff; font-size: 2rem;">⏳ Pending Premium Upgrades</h1>
        <p class="mb-4" style="color: #94A3B8;">Review company payments and approve premium packages (+50 posts).</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-ok p-3 mb-3">@TempData["Success"]</div>
        }

        @if (Model.Any())
        {
            <div class="adm-card table-responsive">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Transaction ID</th>
                            <th>Company ID</th>
                            <th>Package</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="txn-id">@item.TransactionId</span></td>
                                <td>Company #@item.CompanyId</td>
                                <td><span class="tag tag-blue">@item.PackageName</span></td>
                                <td><span class="amount">$@item.Amount</span></td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <form asp-action="ApproveUpgrade" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-ok" onclick="return confirm('Approve this upgrade and add +50 posts?');">
                                                <i class="bi bi-check-circle me-1"></i>Approve (+50)
                                            </button>
                                        </form>
                                        <form asp-action="RejectUpgrade" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-del" onclick="return confirm('Reject this upgrade?');">
                                                <i class="bi bi-x-circle me-1"></i>Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-box">
                <div class="display-4 mb-3">🎉</div>
                <h5 class="fw-bold" style="color: #fff;">All caught up!</h5>
                <p class="mb-0" style="color: #94A3B8;">No pending upgrade requests at this time.</p>
            </div>
        }

        <a asp-action="Index" class="btn-back mt-4">← Back to Dashboard</a>
    </div>
</section>