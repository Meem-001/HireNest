@model IEnumerable<InternshipManagementSystem.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}

<style>
    .adm-page {
        background: #0B1220;
        min-height: 100vh;
        padding: 3rem 0 4rem;
        color: #E2E8F0;
    }

    .adm-label {
        color: #FBBF24;
        letter-spacing: 2px;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .adm-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-table {
        margin: 0;
        width: 100%;
    }

        .adm-table thead th {
            background: rgba(148,163,184,.06);
            color: #94A3B8;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: .9rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .adm-table tbody td {
            padding: 1rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.08);
            color: #CBD5E1;
            font-size: .9rem;
            vertical-align: middle;
        }

        .adm-table tbody tr:hover {
            background: rgba(148,163,184,.04);
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tag {
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 600;
        padding: .3rem .7rem;
    }

    .tag-blue {
        background: rgba(59,130,246,.12);
        color: #60A5FA;
        border: 1px solid rgba(59,130,246,.35);
    }

    .tag-green {
        background: rgba(52,211,153,.12);
        color: #34D399;
        border: 1px solid rgba(52,211,153,.35);
    }

    .tag-amber {
        background: rgba(245,158,11,.12);
        color: #FBBF24;
        border: 1px solid rgba(245,158,11,.4);
    }

    .avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(59,130,246,.15);
        color: #60A5FA;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        font-weight: 700;
        margin-right: .6rem;
        flex-shrink: 0;
    }

    .btn-del {
        background: rgba(248,113,113,.1);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .35rem .8rem;
    }

        .btn-del:hover {
            background: rgba(248,113,113,.2);
            color: #FCA5A5;
        }

    .btn-back {
        background: rgba(148,163,184,.08);
        color: #CBD5E1;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1.2rem;
        text-decoration: none;
        display: inline-block;
    }

        .btn-back:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }

    .alert-ok {
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.35);
        color: #34D399;
        border-radius: 10px;
    }

    .alert-warn {
        background: rgba(245,158,11,.1);
        border: 1px solid rgba(245,158,11,.4);
        color: #FBBF24;
        border-radius: 10px;
    }
</style>

<section class="adm-page">
    <div class="container">
        <div class="adm-label mb-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin / Users</div>
        <h1 class="fw-bold mb-1" style="color: #fff; font-size: 2rem;">👥 Manage Users</h1>
        <p class="mb-4" style="color: #94A3B8;">View and delete registered users.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-ok p-3 mb-3">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert-warn p-3 mb-3">@TempData["Error"]</div>
        }

        <div class="adm-card table-responsive">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Registered On</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var parts = user.FullName.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
                        var initials = (parts.Length > 1 ? parts[0][0] + "" + parts[1][0] : user.FullName.Substring(0, System.Math.Min(2, user.FullName.Length))).ToUpper();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar">@initials</span>
                                    <span style="color: #fff; font-weight: 600;">@user.FullName</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="tag @(user.Role == "Admin" ? "tag-amber" : user.Role == "Company" ? "tag-blue" : "tag-green")">@user.Role</span>
                            </td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <form asp-action="DeleteUser" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn-del"><i class="bi bi-trash3 me-1"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-action="Index" class="btn-back mt-4">← Back to Dashboard</a>
    </div>
</section>