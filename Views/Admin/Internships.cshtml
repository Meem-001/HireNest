@model IEnumerable<InternshipManagementSystem.Models.Internship>
@{
    ViewData["Title"] = "Manage Internships";
}

<style>
    .adm-page {
        background: #0B1220;
        min-height: 100vh;
        padding: 3rem 0 4rem;
        color: #E2E8F0;
    }

    .adm-label {
        color: #FBBF24;
        letter-spacing: 2px;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .adm-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-table {
        margin: 0;
        width: 100%;
    }

        .adm-table thead th {
            background: rgba(148,163,184,.06);
            color: #94A3B8;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: .9rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.15);
        }

        .adm-table tbody td {
            padding: 1rem 1.2rem;
            border-bottom: 1px solid rgba(148,163,184,.08);
            color: #CBD5E1;
            font-size: .9rem;
            vertical-align: middle;
        }

        .adm-table tbody tr:hover {
            background: rgba(148,163,184,.04);
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

    .tag {
        border-radius: 50px;
        font-size: .72rem;
        font-weight: 600;
        padding: .3rem .7rem;
    }

    .tag-gray {
        background: rgba(148,163,184,.1);
        color: #94A3B8;
        border: 1px solid rgba(148,163,184,.25);
    }

    .tag-blue {
        background: rgba(59,130,246,.12);
        color: #60A5FA;
        border: 1px solid rgba(59,130,246,.35);
    }

    .btn-del {
        background: rgba(248,113,113,.1);
        color: #F87171;
        border: 1px solid rgba(248,113,113,.4);
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        padding: .35rem .8rem;
    }

        .btn-del:hover {
            background: rgba(248,113,113,.2);
            color: #FCA5A5;
        }

    .btn-back {
        background: rgba(148,163,184,.08);
        color: #CBD5E1;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .5rem 1.2rem;
        text-decoration: none;
        display: inline-block;
    }

        .btn-back:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }
</style>

<section class="adm-page">
    <div class="container">
        <div class="adm-label mb-2"><i class="bi bi-shield-lock-fill me-1"></i>Admin / Internships</div>
        <h1 class="fw-bold mb-1" style="color: #fff; font-size: 2rem;">💼 Manage Internships</h1>
        <p class="mb-4" style="color: #94A3B8;">View and delete posted internships.</p>

        <div class="adm-card table-responsive">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Duration</th>
                        <th>Posted By</th>
                        <th>Posted On</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="color: #fff; font-weight: 600;">@item.Title</td>
                            <td><i class="bi bi-geo-alt me-1" style="color: #64748B;"></i>@item.Location</td>
                            <td><span class="tag tag-gray">@item.Duration</span></td>
                            <td><span class="tag tag-blue">Company #@item.CompanyId</span></td>
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <form asp-action="DeleteInternship" method="post" style="display:inline;" onsubmit="return confirm('Admin: Delete this internship?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-del"><i class="bi bi-trash3 me-1"></i>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-action="Index" class="btn-back mt-4">← Back to Dashboard</a>
    </div>
</section>