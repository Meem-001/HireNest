@{
    ViewData["Title"] = "Login";
    var role = ViewBag.Role ?? "Student";
    var isCompany = role == "Company";
}

<style>
    .login-dark {
        min-height: 100vh;
        background: #0B1220;
        color: #E2E8F0;
        display: flex;
        align-items: center;
        padding: 4rem 0;
    }

    .lg-glow {
        background: radial-gradient(500px 350px at 50% 45%, rgba(59,130,246,.14), transparent 65%);
        border-radius: 20px;
    }

    .lg-input {
        width: 100%;
        background: rgba(148,163,184,.06);
        border: 1px solid rgba(148,163,184,.2);
        color: #E2E8F0;
        border-radius: 10px;
        padding: .85rem 1rem;
        font-size: .95rem;
    }

        .lg-input::placeholder {
            color: #475569;
        }

        .lg-input:focus {
            outline: none;
            border-color: #3B82F6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
        }

    .lg-label {
        font-size: .8rem;
        font-weight: 600;
        color: #94A3B8;
        margin-bottom: .4rem;
        display: block;
    }

    .role-toggle {
        display: flex;
        background: rgba(148,163,184,.06);
        border: 1px solid rgba(148,163,184,.2);
        border-radius: 10px;
        padding: 4px;
        gap: 4px;
    }

    .role-btn {
        flex: 1;
        text-align: center;
        padding: .6rem .5rem;
        border-radius: 8px;
        font-size: .85rem;
        font-weight: 600;
        color: #94A3B8;
        text-decoration: none;
        transition: all .2s;
    }

        .role-btn.active {
            background: #2563EB;
            color: #fff;
        }

        .role-btn:not(.active):hover {
            color: #E2E8F0;
            background: rgba(148,163,184,.08);
        }

    .btn-signin {
        width: 100%;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        padding: .9rem;
        transition: all .2s;
    }

        .btn-signin:hover {
            background: #1D4ED8;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(37,99,235,.35);
        }

    .link-blue {
        color: #60A5FA;
        text-decoration: none;
        font-weight: 600;
    }

        .link-blue:hover {
            color: #93C5FD;
            text-decoration: underline;
        }

    .link-gray {
        color: #64748B;
        text-decoration: none;
        font-size: .8rem;
    }

        .link-gray:hover {
            color: #CBD5E1;
        }

    .perk-row {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: .9rem;
        color: #CBD5E1;
        font-size: .88rem;
        text-align: left;
    }

    .testimonial-card {
        background: rgba(15,23,42,.6);
        border: 1px solid rgba(148,163,184,.15);
        border-radius: 14px;
        padding: 1.3rem 1.5rem;
    }

    .avatar-sm {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(59,130,246,.2);
        color: #60A5FA;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .show-btn {
        background: none;
        border: none;
        color: #64748B;
        font-size: .75rem;
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
    }

        .show-btn:hover {
            color: #CBD5E1;
        }

    .demo-hint {
        font-size: .75rem;
        color: #64748B;
        margin-top: .4rem;
    }

        .demo-hint span {
            color: #60A5FA;
        }

    .validation-summary-valid {
        display: none;
    }

    .validation-summary-errors {
        color: #F87171;
        background: rgba(248,113,113,.08);
        border: 1px solid rgba(248,113,113,.35);
        border-radius: 10px;
        padding: .6rem 1rem;
        font-size: .85rem;
        margin-bottom: 1rem;
    }
</style>

<div class="login-dark">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- ===== LEFT: Brand Panel ===== -->
            <div class="col-lg-6">
                <div class="lg-glow p-5 text-center">
                    <h2 class="fw-bold mb-5" style="font-size: 1.7rem; color: #fff;">Hire<span style="color: #3B82F6;">Nest</span></h2>
                    <h1 class="fw-bold mb-3" style="color: #fff; font-size: 2.1rem; line-height: 1.3;">
                        Your next opportunity<br />is waiting.
                    </h1>
                    <p class="mb-5" style="color: #94A3B8;">Thousands of students found their dream internship through HireNest.</p>

                    <div style="display: inline-block;">
                        <div class="perk-row"><span>🎯</span> AI-powered skill matching</div>
                        <div class="perk-row"><span>📊</span> Real-time application tracking</div>
                        <div class="perk-row"><span>🏢</span> 840+ verified partner companies</div>
                    </div>

                    <div class="testimonial-card text-start mt-4">
                        <p class="mb-3" style="color: #CBD5E1; font-style: italic; font-size: .9rem;">
                            "Found my ML internship at a top startup in just 2 weeks. The skill match feature is incredible."
                        </p>
                        <div class="d-flex align-items-center">
                            <span class="avatar-sm me-3">A</span>
                            <div>
                                <div class="fw-bold" style="color: #fff; font-size: .85rem;">Halima Khatun Meem</div>
                                <small style="color: #64748B;">IUBAT — Batch 232</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ===== RIGHT: Login Form ===== -->
            <div class="col-lg-6">
                <div style="max-width: 420px; margin-left: auto;">
                    <h3 class="fw-bold mb-1" style="color: #fff; font-size: 1.5rem;">Welcome back</h3>
                    <p class="mb-4" style="color: #94A3B8; font-size: .9rem;">Sign in to your account to continue</p>

                    <!-- Role Toggle -->
                    <div class="role-toggle mb-4">
                        <a class="role-btn @(isCompany ? "" : "active")" asp-controller="Account" asp-action="Login" asp-route-role="Student">
                            🎓 Student
                        </a>
                        <a class="role-btn @(isCompany ? "active" : "")" asp-controller="Account" asp-action="Login" asp-route-role="Company">
                            🏢 Company
                        </a>
                    </div>

                    <div asp-validation-summary="All"></div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="@role" />

                        <div class="mb-3">
                            <label class="lg-label">Email address</label>
                            <input type="email" name="email" class="lg-input" placeholder="@(isCompany ? "hr@company.com" : "student@demo.com")" required />
                        </div>

                        <div class="mb-2">
                            <label class="lg-label">Password</label>
                            <div style="position: relative;">
                                <input type="password" name="password" id="pwd" class="lg-input" placeholder="demo123" required />
                                <button type="button" class="show-btn" onclick="togglePwd()">Show</button>
                            </div>
                            <div class="demo-hint">Demo: <span>demo123</span></div>
                        </div>

                        <button type="submit" class="btn-signin mt-3">Sign In</button>
                    </form>

                    <div class="text-center mt-4" style="font-size: .85rem; color: #94A3B8;">
                        Don't have an account?
                        @if (isCompany)
                        {
                            <a asp-controller="Account" asp-action="RegisterCompany" class="link-blue">Create one</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="link-blue">Create one</a>
                        }
                    </div>

                    <div class="text-center mt-3">
                        <a asp-controller="Account" asp-action="AdminLogin" class="link-gray">Admin Portal →</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePwd() {
        var el = document.getElementById("pwd");
        var btn = el.nextElementSibling;
        if (el.type === "password") { el.type = "text"; btn.textContent = "Hide"; }
        else { el.type = "password"; btn.textContent = "Show"; }
    }
</script>