@model IEnumerable<InternshipManagementSystem.Models.Application>
@{
    ViewData["Title"] = "My Applications";
}

<div class="container mt-4">
    <h2 class="mb-4">My Applications</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered">
                <thead class="table-primary">
                    <tr>
                        <th>Internship</th>
                        <th>Company</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Applied On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model)
                    {
                        <tr>
                            <td>@app.InternshipTitle</td>
                            <td>
                                @if (!string.IsNullOrEmpty(app.CompanyName))
                                {
                                    <strong>@app.CompanyName</strong>
                                }
                                else
                                {
                                    <span class="text-muted">Unknown</span>
                                }
                            </td>
                            <td>@app.InternshipLocation</td>
                            <td>
                                <span class="badge @(app.Status == "Accepted" ? "bg-success" : app.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                    @app.Status
                                </span>

                                @if (!string.IsNullOrEmpty(app.Feedback))
                                {
                                    <div class="mt-2 small text-muted border-start ps-2 border-primary">
                                        <strong>Feedback:</strong> @app.Feedback
                                    </div>
                                }
                            </td>
                            <td>@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">You haven't applied to any internships yet.</div>
    }
</div>