@{
    ViewData["Title"] = "HireNest - Find Real-World Experience";
}

<style>
    .hn-dark {
        background: #0B1220;
        color: #E2E8F0;
    }

    .hero-dark {
        background: radial-gradient(900px 480px at 75% 18%, rgba(59,130,246,0.16), transparent 60%), radial-gradient(700px 380px at 15% 85%, rgba(99,102,241,0.10), transparent 60%), #0B1220;
    }

    .text-gray {
        color: #94A3B8;
    }

    .badge-live {
        border: 1px solid rgba(59,130,246,0.4);
        color: #60A5FA;
        background: rgba(59,130,246,0.08);
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #3B82F6;
        display: inline-block;
        animation: pulse 1.6s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(59,130,246,.5);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(59,130,246,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(59,130,246,0);
        }
    }

    .grad-text {
        background: linear-gradient(90deg, #3B82F6, #6366F1);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .btn-blue {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        padding: .8rem 1.6rem;
        transition: all .2s;
    }

        .btn-blue:hover {
            background: #1D4ED8;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(37,99,235,.35);
        }

    .btn-ghost {
        background: rgba(148,163,184,.08);
        color: #E2E8F0;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 10px;
        font-weight: 600;
        padding: .8rem 1.6rem;
        transition: all .2s;
    }

        .btn-ghost:hover {
            background: rgba(148,163,184,.15);
            color: #fff;
        }

    .link-plain {
        color: #94A3B8;
        text-decoration: none;
        font-weight: 500;
    }

        .link-plain:hover {
            color: #fff;
        }

    .stat-num {
        color: #60A5FA;
        font-weight: 700;
        font-size: 1.5rem;
    }

    .stat-label {
        color: #64748B;
        font-size: .8rem;
    }

    .job-card {
        background: rgba(15,23,42,.65);
        border: 1px solid rgba(148,163,184,.18);
        border-radius: 16px;
        backdrop-filter: blur(8px);
        transition: transform .15s ease-out, opacity .25s ease;
    }

    .job-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 1px solid rgba(59,130,246,.4);
        color: #60A5FA;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        background: rgba(59,130,246,.08);
    }

    .match-pill {
        color: #34D399;
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.35);
        border-radius: 50px;
        font-size: .75rem;
        font-weight: 600;
        padding: .3rem .8rem;
    }

    .skill-tag {
        background: rgba(148,163,184,.1);
        border: 1px solid rgba(148,163,184,.2);
        color: #CBD5E1;
        border-radius: 6px;
        font-size: .75rem;
        padding: .25rem .6rem;
    }

    .salary {
        color: #34D399;
        font-weight: 700;
    }

    .jdot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #334155;
        display: inline-block;
        transition: all .3s;
    }

        .jdot.active {
            width: 18px;
            border-radius: 5px;
            background: #3B82F6;
        }

    .feature-card {
        background: rgba(148,163,184,.04);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 14px;
        transition: all .25s;
        height: 100%;
    }

        .feature-card:hover {
            border-color: rgba(59,130,246,.5);
            transform: translateY(-4px);
        }

    .cta-card {
        background: linear-gradient(135deg, #1E2B6B 0%, #161E4A 100%);
        border: 1px solid rgba(99,102,241,.35);
        border-radius: 20px;
    }

    .admin-strip {
        background: rgba(245,158,11,.05);
        border: 1px solid rgba(245,158,11,.35);
        border-radius: 14px;
    }

    .btn-amber {
        background: rgba(245,158,11,.12);
        color: #FBBF24;
        border: 1px solid rgba(245,158,11,.5);
        border-radius: 10px;
        font-weight: 600;
    }

        .btn-amber:hover {
            background: rgba(245,158,11,.22);
            color: #FDE68A;
        }
</style>

<!-- ===== HERO ===== -->
<section class="hero-dark">
    <div class="container" style="padding-top: 6rem; padding-bottom: 5rem;">
        <div class="row align-items-center g-5">

            <!-- Left -->
            <div class="col-lg-6">
                <span class="badge badge-live rounded-pill px-3 py-2 mb-4 fw-semibold">
                    <span class="live-dot me-2"></span>Live internships available right now
                </span>
                <h1 class="fw-bold" style="font-size: clamp(2.6rem, 5vw, 3.8rem); line-height: 1.12; color: #fff;">
                    Find<br />
                    <span class="grad-text">Real-World Experience.</span>
                </h1>
                <p class="text-gray mt-4 mb-4" style="max-width: 480px; font-size: 1.05rem;">
                    HireNest connects ambitious students with top companies. Our skill-match algorithm surfaces the best opportunities for your unique profile.
                </p>

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-blue">Find My Internship</a>
                        <a asp-controller="Internship" asp-action="Index" class="btn btn-ghost"><i class="bi bi-search me-2"></i>Browse Jobs</a>
                        <a asp-controller="Account" asp-action="RegisterCompany" class="link-plain">Post Internships →</a>
                    }
                    else if (User.IsInRole("Company"))
                    {
                        <a asp-controller="Internship" asp-action="Create" class="btn btn-blue">Post an Internship</a>
                        <a asp-controller="Internship" asp-action="Index" class="btn btn-ghost"><i class="bi bi-search me-2"></i>Browse Jobs</a>
                    }
                    else
                    {
                        <a asp-controller="Internship" asp-action="Index" class="btn btn-blue">Find My Internship</a>
                        <a asp-controller="Internship" asp-action="Index" class="btn btn-ghost"><i class="bi bi-search me-2"></i>Browse Jobs</a>
                    }
                </div>

                <div class="row mt-5 g-4" style="max-width: 540px;">
                    <div class="col-6 col-md-3"><div class="stat-num">2,400+</div><div class="stat-label">Active Internships</div></div>
                    <div class="col-6 col-md-3"><div class="stat-num">840+</div><div class="stat-label">Partner Companies</div></div>
                    <div class="col-6 col-md-3"><div class="stat-num">18,000+</div><div class="stat-label">Students Placed</div></div>
                    <div class="col-6 col-md-3"><div class="stat-num">94%</div><div class="stat-label">Satisfaction Rate</div></div>
                </div>
            </div>

            <!-- Right: Live Job Card -->
            <div class="col-lg-6">
                <div id="tiltCard" class="job-card p-4" style="max-width: 480px; margin-left: auto;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="job-icon"><i class="bi bi-briefcase"></i></div>
                        <span id="jobMatch" class="match-pill">85% match</span>
                    </div>
                    <h5 id="jobTitle" class="fw-bold mb-1" style="color: #fff;">ML Research Intern</h5>
                    <div id="jobCompany" class="text-gray small mb-3">StartupAI</div>
                    <div class="d-flex align-items-center gap-3 mb-3 small">
                        <span id="jobLocation" class="text-gray"><i class="bi bi-geo-alt me-1"></i>Gulshan, Dhaka</span>
                        <span id="jobType" style="color: #60A5FA;">Onsite</span>
                    </div>
                    <div id="jobSkills" class="d-flex gap-2 mb-4 flex-wrap">
                        <span class="skill-tag">Python</span><span class="skill-tag">TensorFlow</span><span class="skill-tag">NLP</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px solid rgba(148,163,184,.15);">
                        <span id="jobSalary" class="salary">৳8,000/mo</span>
                        <a asp-controller="Internship" asp-action="Index" class="link-plain small">View Details →</a>
                    </div>
                </div>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <span class="jdot active"></span><span class="jdot"></span><span class="jdot"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== FEATURES ===== -->
<section class="hn-dark" style="padding: 5rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="fw-bold text-uppercase" style="color: #60A5FA; letter-spacing: 2px; font-size: .8rem;">Why HireNest</div>
            <h2 class="fw-bold mt-2" style="color: #fff;">Everything you need to land your internship</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card p-4">
                    <div class="fs-4 mb-3">🎯</div>
                    <h6 class="fw-bold" style="color: #fff;">AI Skill Match</h6>
                    <p class="text-gray small mb-0">Our algorithm scores your profile against every job requirement — see your match % before you apply.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card p-4">
                    <div class="fs-4 mb-3">📄</div>
                    <h6 class="fw-bold" style="color: #fff;">CV Builder</h6>
                    <p class="text-gray small mb-0">Build a polished, ATS-ready CV with education, experience, skills, and a professional photo.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card p-4">
                    <div class="fs-4 mb-3">📊</div>
                    <h6 class="fw-bold" style="color: #fff;">Application Tracker</h6>
                    <p class="text-gray small mb-0">Track every application status in real time — from pending to offer in one clean dashboard.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card p-4">
                    <div class="fs-4 mb-3">🏢</div>
                    <h6 class="fw-bold" style="color: #fff;">Verified Companies</h6>
                    <p class="text-gray small mb-0">Every company is vetted. Only real internships from real organizations with real stipends.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== CTA + ADMIN STRIP ===== -->
<section class="hn-dark" style="padding-bottom: 4rem;">
    <div class="container">
        <div class="cta-card text-center p-5">
            <h2 class="fw-bold" style="color: #fff;">Ready to find your match?</h2>
            <p class="text-gray mt-2 mb-4">Join thousands of students who found their internship through HireNest.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Internship" asp-action="Index" class="btn btn-ghost"><i class="bi bi-search me-2"></i>Browse Internships</a>
                @if (!User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-blue">Create Student Account</a>
                    <a asp-controller="Account" asp-action="RegisterCompany" class="btn btn-ghost">Register Company</a>
                }
                else if (User.IsInRole("Company"))
                {
                    <a asp-controller="Internship" asp-action="Create" class="btn btn-blue">Post an Internship</a>
                }
            </div>
        </div>

        <div class="admin-strip d-flex flex-wrap align-items-center justify-content-between p-4 mt-4">
            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center me-3" style="width: 44px; height: 44px; border-radius: 10px; background: rgba(245,158,11,.15); color: #FBBF24;">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <div>
                    <div class="fw-bold" style="color: #fff;">HireNest Admin Portal</div>
                    <small class="text-gray">Manage users, internships, applications, and premium upgrades.</small>
                </div>
            </div>
            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-amber mt-3 mt-md-0"><i class="bi bi-lock-fill me-2"></i>Enter Admin Portal</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-amber mt-3 mt-md-0"><i class="bi bi-lock-fill me-2"></i>Enter Admin Portal</a>
            }
        </div>
    </div>
</section>

<!-- ===== INTERACTIVE SCRIPTS ===== -->
<script>
    // Rotating live job card + dots + 3D tilt
    (function () {
               var jobs = [
            { title: "ML Research Intern", company: "StartupAI", match: "85% match", loc: "Gulshan, Dhaka", type: "Onsite", salary: "৳8,000/mo", skills: ["Python", "TensorFlow", "NLP"] },
            { title: "Software Engineering Intern", company: "TechCorp", match: "95% match", loc: "Banani, Dhaka", type: "Remote", salary: "৳12,000/mo", skills: ["React", "Node.js", "SQL"] },
            { title: "UI/UX Design Intern", company: "PixelStudio", match: "92% match", loc: "Agrabad, Chattogram", type: "Hybrid", salary: "৳10,000/mo", skills: ["Figma", "Adobe XD", "CSS"] }
        ];
        var ji = 0;
        var card = document.getElementById("tiltCard");
        var dots = document.querySelectorAll(".jdot");

        setInterval(function () {
            ji = (ji + 1) % jobs.length;
            var j = jobs[ji];
            card.style.opacity = "0";
            setTimeout(function () {
                document.getElementById("jobTitle").textContent = j.title;
                document.getElementById("jobCompany").textContent = j.company;
                document.getElementById("jobMatch").textContent = j.match;
                document.getElementById("jobLocation").innerHTML = '<i class="bi bi-geo-alt me-1"></i>' + j.loc;
                document.getElementById("jobType").textContent = j.type;
                document.getElementById("jobSalary").textContent = j.salary;
                var html = "";
                for (var i = 0; i < j.skills.length; i++) html += '<span class="skill-tag">' + j.skills[i] + '</span>';
                document.getElementById("jobSkills").innerHTML = html;
                for (var d = 0; d < dots.length; d++) dots[d].className = "jdot" + (d === ji ? " active" : "");
                card.style.opacity = "1";
            }, 250);
        }, 4000);

        // 3D tilt
        card.addEventListener("mousemove", function (e) {
            var r = card.getBoundingClientRect();
            var x = (e.clientX - r.left) / r.width - 0.5;
            var y = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform = "perspective(900px) rotateY(" + (x * 6) + "deg) rotateX(" + (-y * 6) + "deg)";
        });
        card.addEventListener("mouseleave", function () {
            card.style.transform = "perspective(900px) rotateX(0deg) rotateY(0deg)";
        });
    })();
</script>