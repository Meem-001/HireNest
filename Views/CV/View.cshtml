@model InternshipManagementSystem.Models.CV
@{
    ViewData["Title"] = "My CV";
}

<div class="container mt-4">
    <!-- ✅ FIXED: Perfectly aligned header and buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print flex-wrap gap-3">
        <h2 class="mb-0">📄 My Professional CV</h2>

        <div class="d-flex gap-2 flex-wrap">
            @if (ViewBag.IsPreview == true)
            {
                <!-- Preview Mode Buttons -->
                <a asp-action="Edit" class="btn btn-outline-secondary">✏️ Edit</a>

                <!-- Form to actually save to database -->
                <form asp-action="ConfirmSave" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">💾 Save CV</button>
                </form>
            }
            else
            {
                <!-- Final Saved Mode Buttons -->
                <a asp-action="Edit" class="btn btn-outline-primary">✏️ Edit</a>
                <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ Print</button>
                <button onclick="downloadPDF()" class="btn btn-danger">📥 Download PDF</button>
            }
        </div>
    </div>

    <!-- CV Paper -->
    <div id="cv-content" class="card shadow-lg border-0" style="background: white; min-height: 1000px;">
        <div class="card-body p-5">
            <!-- Header with Photo -->
            <div class="row mb-4 border-bottom pb-4">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.PhotoFileName))
                    {
                        <img src="~/photos/@Model.PhotoFileName"
                             alt="Profile"
                             class="rounded-circle border border-3 border-primary"
                             style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto"
                             style="width: 150px; height: 150px; font-size: 3rem;">
                            @Model.StudentName?.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <h1 class="display-4 text-primary mb-2">@Model.StudentName</h1>
                    <p class="lead text-muted mb-3">@Model.Objective</p>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>📧 Email:</strong> @Model.StudentEmail</p>
                            <p class="mb-1"><strong>📱 Phone:</strong> @Model.Phone</p>
                        </div>
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.LinkedIn))
                            {
                                <p class="mb-1"><strong>🔗 LinkedIn:</strong> @Model.LinkedIn</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Skills -->
            
            @if (!string.IsNullOrEmpty(Model.Skills))
            {
                <div class="mb-4">
                    <h4 class="text-primary border-bottom pb-2 mb-3">
                        🛠️ Skills
                    </h4>
                    <p class="text-muted">@Model.Skills</p>
                </div>
            }

           
         
            <!-- Interests -->
            @if (!string.IsNullOrEmpty(Model.Interests))
            {
                <div class="mb-4">
                    <h4 class="text-primary border-bottom pb-2 mb-3">
                        🎯 Interests
                    </h4>
                    <p class="text-muted">@Model.Interests</p>
                </div>
            }

            <!-- Education -->
            <div class="mb-4">
                <h4 class="text-primary border-bottom pb-2 mb-3">
                    🎓 Education
                </h4>
                <div style="white-space: pre-line;">@Model.Education</div>
            </div>

            <!-- Experience -->
            <div class="mb-4">
                <h4 class="text-primary border-bottom pb-2 mb-3">
                    💼 Experience & Projects
                </h4>
                <div style="white-space: pre-line;">@Model.Experience</div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<!-- PDF Download Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function downloadPDF() {
        const element = document.getElementById('cv-content');
        const opt = {
            margin: 0.5,
            filename: '@Model.StudentName - CV.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        };
        html2pdf().set(opt).from(element).save();
    }
</script>

<style>
    @@media print {
        .no-print, header, footer {
            display: none !important;
        }

        body {
            background-color: white !important;
        }

        #cv-content {
            box-shadow: none !important;
            border: none !important;
        }
    }
</style>